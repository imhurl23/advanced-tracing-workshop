# Everything the workshop needs. Fill in the two <...> values, then load it into your
# shell once per terminal — before starting your coding agent — from the repo root:
#
#   set -a; source .env; set +a
#
# The Python agent / Streamlit / evals also read this file directly (load_dotenv()).
#
# You only need ONE key: paste your Braintrust API key below. OpenAI calls go through
# the Braintrust AI gateway, which uses the OpenAI key configured in the workshop org,
# so OPENAI_API_KEY just reuses your Braintrust key (keep BRAINTRUST_API_KEY above it).
BRAINTRUST_API_KEY="<paste your Braintrust API key>"
OPENAI_BASE_URL="https://gateway.braintrust.dev"
OPENAI_API_KEY="${BRAINTRUST_API_KEY}"

# Braintrust context — read by the bt CLI and the Python code.
BRAINTRUST_DEFAULT_PROJECT="<your-name>-stonks"
# BRAINTRUST_PROFILE="dataoutpost-workshop"
BRAINTRUST_ORG_NAME="dataoutpost-workshop"
